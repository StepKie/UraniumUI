<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>2.11.0</PackageVersion>
    <Title>UraniumUI MAUI Templates</Title>
    <Authors>enisn</Authors>
    <Description>Templates for new .NET MAUI apps, themes, and libraries built with UraniumUI.</Description>
    <PackageTags>dotnet-new;templates;maui;uraniumui;presentation-framework</PackageTags>

    <TargetFramework>net10.0</TargetFramework>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="**\*" Exclude="**\bin\**;templates\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
